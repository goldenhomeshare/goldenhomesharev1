generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                                        String              @id @unique
  email                                                     String
  firstName                                                 String
  lastName                                                  String
  profileImage                                              String
  connectedAccountId                                        String              @unique
  stripeConnectedLinked                                     Boolean             @default(false)
  createdAt                                                 DateTime            @default(now())
  isVerified                                                Boolean             @default(false)
  onboardingCompleted                                       Boolean             @default(false)
  updatedAt                                                 DateTime            @updatedAt
  userType                                                  UserType?
  Applications                                              Application[]
  homeownerChats                                            ChatRoom[]          @relation("HomeownerChats")
  housemateChats                                            ChatRoom[]          @relation("HousemateChats")
  homeownerProfile                                          HomeownerProfile?
  housemateProfile                                          HousemateProfile?
  sentMessages                                              Message[]           @relation("SentMessages")
  Product                                                   Product[]
  background_checks_background_checks_candidateUserIdToUser background_checks[] @relation("background_checks_candidateUserIdToUser")
  background_checks_background_checks_requestedByIdToUser   background_checks[] @relation("background_checks_requestedByIdToUser")
}

model HomeownerProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  propertyCount        Int      @default(0)
  averageRating        Float?
  bio                  String?
  emergencyContact     Json?
  backgroundCheck      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ageRange             String?
  gender               String?
  hobbies              Json?
  profilePicture       String?
  schedule             String?
  socialPreference     String?
  lifestyle            Json?
  preferredGender      String?
  socialMedia          Json?
  preferredCareerStage String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HousemateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  age              Int?
  occupation       String?
  bio              String?
  lifestyle        Json?
  references       Json?
  budgetRange      Json?
  backgroundCheck  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ageRange         String?
  gender           String?
  hobbies          Json?
  profilePicture   String?
  schedule         String?
  socialPreference String?
  maxBudget        Int?
  preferredGender  String?
  socialMedia      Json?
  canHelpWith      Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id          String            @id @default(uuid())
  housemateId String
  productId   String
  status      ApplicationStatus @default(PENDING)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  moveInDate  DateTime?
  moveOutDate DateTime?
  housemate   User              @relation(fields: [housemateId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([housemateId, productId])
}

model ChatRoom {
  id                String    @id @default(uuid())
  homeownerId       String
  housemateId       String
  productId         String?
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  hiddenByHomeowner Boolean   @default(false)
  hiddenByHousemate Boolean   @default(false)
  homeownerHiddenAt DateTime?
  housemateHiddenAt DateTime?
  homeowner         User      @relation("HomeownerChats", fields: [homeownerId], references: [id], onDelete: Cascade)
  housemate         User      @relation("HousemateChats", fields: [housemateId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@unique([homeownerId, housemateId, productId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  chatRoomId String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Product {
  id               String         @id @default(uuid())
  name             String
  price            Int
  smallDescription String
  description      Json
  images           String[]
  productFile      String
  category         CategoryTypes?
  amenities        Json?
  supportRequested Json?
  houseRules       Json?
  createdAt        DateTime       @default(now())
  userId           String?
  address          String?
  applications     Application[]
  chatRooms        ChatRoom[]
  User             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model background_checks {
  id                                           String                @id
  candidateId                                  String                @unique
  invitationId                                 String?
  reportId                                     String?
  requestedById                                String?
  candidateUserId                              String?
  candidateEmail                               String
  candidateName                                String
  candidatePhone                               String?
  status                                       BackgroundCheckStatus @default(PENDING)
  checkrStatus                                 String?
  invitationUrl                                String?
  invitationStatus                             String?
  completedAt                                  DateTime?
  invitationSentAt                             DateTime?
  createdAt                                    DateTime              @default(now())
  updatedAt                                    DateTime
  User_background_checks_candidateUserIdToUser User?                 @relation("background_checks_candidateUserIdToUser", fields: [candidateUserId], references: [id])
  User_background_checks_requestedByIdToUser   User?                 @relation("background_checks_requestedByIdToUser", fields: [requestedById], references: [id])
}

enum UserType {
  HOMEOWNER
  HOUSEMATE
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CategoryTypes {
  template
  uikit
  icon
}

enum BackgroundCheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CLEAR
  CONSIDER
  DISPUTE
  EXPIRED
  DECLINED
  FAILED
}
