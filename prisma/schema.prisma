generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String            @id @unique
  email                 String
  firstName             String
  lastName              String
  profileImage          String
  connectedAccountId    String?           @unique
  stripeConnectedLinked Boolean           @default(false)
  createdAt             DateTime          @default(now())
  isVerified            Boolean           @default(false)
  onboardingCompleted   Boolean           @default(false)
  updatedAt             DateTime          @updatedAt
  userType              UserType?
  dateOfBirth           DateTime?
  middleName            String?
  noMiddleName          Boolean           @default(false)
  phone                 String?
  zipcode               String?
  Applications          Application[]
  homeownerChats        ChatRoom[]        @relation("HomeownerChats")
  housemateChats        ChatRoom[]        @relation("HousemateChats")
  homeownerProfile      HomeownerProfile?
  housemateProfile      HousemateProfile?
  sentMessages          Message[]         @relation("SentMessages")
  Product               Product[]
  backgroundChecks      BackgroundCheck[] @relation("UserBackgroundChecks")
  requestedChecks       BackgroundCheck[] @relation("RequestedBackgroundChecks")
}

model HomeownerProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  propertyCount        Int      @default(0)
  averageRating        Float?
  bio                  String?
  emergencyContact     Json?
  backgroundCheck      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ageRange             String?
  gender               String?
  hobbies              Json?
  profilePicture       String?
  schedule             String?
  socialPreference     String?
  lifestyle            Json?
  preferredGender      String?
  socialMedia          Json?
  preferredCareerStage String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HousemateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  age              Int?
  occupation       String?
  bio              String?
  lifestyle        Json?
  references       Json?
  budgetRange      Json?
  backgroundCheck  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ageRange         String?
  gender           String?
  hobbies          Json?
  profilePicture   String?
  schedule         String?
  socialPreference String?
  maxBudget        Int?
  preferredGender  String?
  socialMedia      Json?
  canHelpWith      Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id           String            @id @default(uuid())
  housemateId  String
  productId    String
  status       ApplicationStatus @default(PENDING)
  message      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  moveInDate   DateTime?
  moveOutDate  DateTime?
  agreement    Agreement?
  housemate    User              @relation(fields: [housemateId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  Subscription Subscription?

  @@unique([housemateId, productId])
}

model Agreement {
  id                 String          @id @default(uuid())
  applicationId      String          @unique
  agreementData      Json
  homeownerSigned    Boolean         @default(false)
  homeownerSignedAt  DateTime?
  homeownerSignature String?
  housemateSigned    Boolean         @default(false)
  housemateSignedAt  DateTime?
  housemateSignature String?
  status             AgreementStatus @default(PENDING_HOMEOWNER)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  application        Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String                @id @default(uuid())
  applicationId        String                @unique
  stripeSubscriptionId String                @unique
  stripeCustomerId     String
  stripePriceId        String?
  stripeProductId      String?
  status               SubscriptionStatus    @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  amount               Int
  currency             String                @default("usd")
  housemateId          String
  homeownerId          String
  productId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  canceledAt           DateTime?
  pausedAt             DateTime?
  Application          Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  SubscriptionPayment  SubscriptionPayment[]
}

model BackgroundCheck {
  id               String                @id @default(uuid())
  candidateId      String                @unique
  invitationId     String?
  reportId         String?
  requestedById    String?
  candidateUserId  String?
  candidateEmail   String
  candidateName    String
  candidatePhone   String?
  candidateZipcode String?
  status           BackgroundCheckStatus @default(PENDING)
  checkrStatus     String?
  invitationUrl    String?
  invitationStatus String?
  completedAt      DateTime?
  invitationSentAt DateTime?
  reportData       Json?
  packageName      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  candidateUser    User?                 @relation("UserBackgroundChecks", fields: [candidateUserId], references: [id])
  requestedBy      User?                 @relation("RequestedBackgroundChecks", fields: [requestedById], references: [id])

  @@map("background_checks")
}

model ChatRoom {
  id                String    @id @default(uuid())
  homeownerId       String
  housemateId       String
  productId         String?
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  hiddenByHomeowner Boolean   @default(false)
  hiddenByHousemate Boolean   @default(false)
  homeownerHiddenAt DateTime?
  housemateHiddenAt DateTime?
  homeowner         User      @relation("HomeownerChats", fields: [homeownerId], references: [id], onDelete: Cascade)
  housemate         User      @relation("HousemateChats", fields: [housemateId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@unique([homeownerId, housemateId, productId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  chatRoomId String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Product {
  id                   String         @id @default(uuid())
  name                 String
  price                Int
  smallDescription     String
  description          Json
  images               String[]
  productFile          String
  category             CategoryTypes?
  amenities            Json?
  supportRequested     Json?
  houseRules           Json?
  createdAt            DateTime       @default(now())
  userId               String?
  address              String?
  isSubscription       Boolean        @default(true)
  stripePriceId        String?
  stripeProductId      String?
  subscriptionInterval String         @default("month")
  applications         Application[]
  chatRooms            ChatRoom[]
  User                 User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionPayment {
  id                    String        @id
  subscriptionId        String
  stripeInvoiceId       String        @unique
  stripePaymentIntentId String?
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime
  Subscription          Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

enum UserType {
  HOMEOWNER
  HOUSEMATE
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AgreementStatus {
  PENDING_HOMEOWNER
  PENDING_HOUSEMATE
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum BackgroundCheckStatus {
  PENDING
  INVITATION_SENT
  IN_PROGRESS
  COMPLETED
  CLEAR
  CONSIDER
  DISPUTE
  DISPUTED
  EXPIRED
  DECLINED
  FAILED
  CANCELED
  PARTIAL_COMPLETE
  SUSPENDED
  PRE_ADVERSE_ACTION
  POST_ADVERSE_ACTION
}

enum CategoryTypes {
  template
  uikit
  icon
}
