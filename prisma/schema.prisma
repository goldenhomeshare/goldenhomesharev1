generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String  @id @unique
  email                 String
  firstName             String
  lastName              String
  profileImage          String
  connectedAccountId    String  @unique
  stripeConnectedLinked Boolean @default(false)
  userType              UserType? // New field - nullable initially for existing users
  isVerified            Boolean @default(false)
  onboardingCompleted   Boolean @default(false)

  // Profile extensions
  homeownerProfile      HomeownerProfile?
  housemateProfile      HousemateProfile?

  Product Product[]
  Applications Application[]
  
  // Chat relations
  homeownerChats        ChatRoom[] @relation("HomeownerChats")
  housemateChats        ChatRoom[] @relation("HousemateChats")
  sentMessages          Message[]  @relation("SentMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserType {
  HOMEOWNER
  HOUSEMATE
  ADMIN
}

// Homeowner-specific profile
model HomeownerProfile {
  id                String @id @default(uuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  profilePicture    String? // URL to uploaded profile picture
  propertyCount     Int    @default(0)
  averageRating     Float? 
  bio               String?
  emergencyContact  Json?  // Contact details for emergencies
  backgroundCheck   Boolean @default(false)
  
  // Profile fields
  gender            String? // Male, Female, Other
  ageRange          String? // 18–24, 25–34, 35–44, 45–54, 55–64, 65+
  schedule          String? // Early Riser, Night Owl, Flexible
  socialPreference  String? // Social, Independent, Balanced
  hobbies           Json?   // Array of selected hobbies
  preferredAgeRanges Json?  // Array of preferred age ranges for housemates
  preferredGender   String? // Preferred gender for housemates
  socialMedia       Json?   // Social media links (instagram, facebook, linkedin)
  lifestyle         Json?   // Lifestyle preferences (pets, smoking policy, etc.)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Housemate-specific profile  
model HousemateProfile {
  id                String @id @default(uuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  profilePicture    String? // URL to uploaded profile picture
  age               Int?
  occupation        String?
  bio               String?
  lifestyle         Json?  // Preferences, habits, etc.
  references        Json?  // Previous landlord/housemate references
  budgetRange       Json?  // Min/max budget
  maxBudget         Int?   // Maximum budget
  backgroundCheck   Boolean @default(false)
  
  // Profile fields
  gender            String? // Male, Female, Other
  ageRange          String? // 18–24, 25–34, 35–44, 45–54, 55–64, 65+
  schedule          String? // Early Riser, Night Owl, Flexible
  socialPreference  String? // Social, Independent, Balanced
  hobbies           Json?   // Array of selected hobbies
  preferredAgeRanges Json?  // Array of preferred age ranges for living companions
  preferredGender   String? // Preferred gender for living companions
  socialMedia       Json?   // Social media links (instagram, facebook, linkedin)
  canHelpWith       Json?   // Array of services the housemate can help with (cleaning, cooking, etc.)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Applications from housemates to homeowners
model Application {
  id              String @id @default(uuid())
  housemateId     String
  housemate       User   @relation(fields: [housemateId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  status          ApplicationStatus @default(PENDING)
  message         String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([housemateId, productId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// Chat-related models for realtime messaging
model ChatRoom {
  id          String @id @default(uuid())
  homeownerId String
  housemateId String
  productId   String?
  
  homeowner   User     @relation("HomeownerChats", fields: [homeownerId], references: [id], onDelete: Cascade)
  housemate   User     @relation("HousemateChats", fields: [housemateId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  messages    Message[]
  
  lastMessageAt DateTime?
  
  // Hide conversation fields
  hiddenByHomeowner Boolean @default(false)
  hiddenByHousemate Boolean @default(false)
  homeownerHiddenAt DateTime?
  housemateHiddenAt DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([homeownerId, housemateId, productId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  chatRoomId String
  
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id               String        @id @default(uuid())
  name             String
  price            Int
  smallDescription String
  description      Json
  images           String[]
  productFile      String
  category         CategoryTypes
  address          String?       // Address of the property
  amenities        Json?         // Array of selected amenities
  supportRequested Json?         // Array of objects with id and hoursPerWeek fields for support options
  houseRules       Json?         // Array of house rules

  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  
  // New field for applications
  applications    Application[]
  chatRooms       ChatRoom[]
}

enum CategoryTypes {
  template
  uikit
  icon
}